# ============================================================
# FarmaCC Pro - Configuração de Ambiente
# ============================================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo e renomeie para ".env"
# 2. Preencha com suas credenciais reais do Firebase
# 3. NUNCA commite o arquivo .env no Git
# 4. Adicione .env ao .gitignore
#
# Para obter suas credenciais:
# - Acesse: https://console.firebase.google.com
# - Selecione seu projeto
# - Vá em: Configurações → Seus apps → Web
# - Copie os valores do objeto firebaseConfig
#
# ============================================================

# Firebase Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Ambiente (development | staging | production)
NODE_ENV=development

# ============================================================
# SEGURANÇA
# ============================================================
# IMPORTANTE: Este arquivo contém informações sensíveis.
# Certifique-se de que está listado no .gitignore
# ============================================================
